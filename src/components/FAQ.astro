---
interface Props {
  itens: { pergunta: string; resposta: string }[];
}
const { itens } = Astro.props;
---
<div class="faq">
  {itens.map((i) => (
    <details>
      <summary>{i.pergunta}</summary>
      <p set:html={i.resposta} />
    </details>
  ))}
</div>

<style>
  .faq { border-top: var(--borda) solid var(--linha); max-width: 52rem; }
  details { border-bottom: var(--borda) solid var(--linha); }
  summary {
    cursor: pointer; list-style: none; padding: var(--e3) var(--e5) var(--e3) 0; position: relative;
    font-family: var(--fonte-display); font-weight: 700; font-size: 1.25rem; line-height: 1.25;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 0; top: var(--e3); font-family: var(--fonte-mono); font-weight: 500; }
  details[open] summary::after { content: '−'; }
  details p { padding-bottom: var(--e3); margin: 0; color: var(--fg-2); max-width: 44rem; }
</style>
