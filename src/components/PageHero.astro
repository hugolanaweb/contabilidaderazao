---
import { marcar } from '../lib/marca';
interface Props {
  kicker: string;
  titulo: string;
  trilha?: { nome: string; href: string }[];
}
const { kicker, titulo, trilha = [] } = Astro.props;
---
<section class="sec sec-tinta ph" data-hero>
  <div class="container">
    {trilha.length > 0 && (
      <nav class="crumbs" aria-label="Trilha de navegação">
        <ol class="lista-limpa">
          <li><a href="/">Início</a></li>
          {trilha.map((t, i) => (
            <li>{i === trilha.length - 1 ? <span aria-current="page">{t.nome}</span> : <a href={t.href}>{t.nome}</a>}</li>
          ))}
        </ol>
      </nav>
    )}
    <p class="kicker">{kicker}</p>
    <h1 class="ph-h1" set:html={marcar(titulo)} />
    <div class="apoio"><slot /></div>
  </div>
</section>

<style>
  .ph { padding-block: var(--e8) var(--e10); }
  .ph-h1 { max-width: 20ch; margin-bottom: var(--e3); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: var(--e1); font-family: var(--fonte-mono); font-size: var(--t-rotulo); margin-bottom: var(--e4); color: var(--fg-2); }
  .crumbs li + li::before { content: '/'; margin-right: var(--e1); }
</style>
