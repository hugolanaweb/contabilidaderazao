---
// Formulário fictício (projeto de estudo): nada é enviado. Para produção, trocar o handler por um endpoint (Formspree/Netlify Forms).
---
<form class="cf" method="post" action="#" data-contato novalidate>
  <p class="cf-fator" data-fator hidden></p>

  <div class="campo">
    <label for="nome">Nome</label>
    <input id="nome" name="nome" type="text" autocomplete="name" required />
  </div>
  <div class="campo">
    <label for="email">E-mail</label>
    <input id="email" name="email" type="email" autocomplete="email" required />
  </div>
  <div class="campo">
    <label for="whatsapp">WhatsApp</label>
    <input id="whatsapp" name="whatsapp" type="tel" autocomplete="tel" inputmode="tel" required />
  </div>
  <div class="campo">
    <label for="faturamento">Faixa de faturamento anual</label>
    <select id="faturamento" name="faturamento" required>
      <option value="">Selecione</option>
      <option>Até R$ 1 mi</option>
      <option>R$ 1 mi a R$ 5 mi</option>
      <option>R$ 5 mi a R$ 10 mi</option>
      <option>R$ 10 mi a R$ 20 mi</option>
      <option>Acima de R$ 20 mi</option>
      <option>Não sei</option>
    </select>
  </div>
  <div class="campo">
    <label for="regime">Regime atual</label>
    <select id="regime" name="regime" required>
      <option value="">Selecione</option>
      <option>Simples Nacional</option>
      <option>Lucro Presumido</option>
      <option>Lucro Real</option>
      <option>Não sei</option>
    </select>
  </div>

  <input type="hidden" name="fator_r" value="" data-fator-campo />
  <!-- honeypot: invisível para pessoas e leitores de tela -->
  <div class="cf-hp" aria-hidden="true">
    <label for="site-url">Não preencha este campo</label>
    <input id="site-url" name="site_url" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="campo campo--check">
    <input id="lgpd" name="lgpd" type="checkbox" required />
    <label for="lgpd">Concordo com o uso destes dados para retornar o contato, conforme a <a href="/privacidade">Política de Privacidade</a>.</label>
  </div>

  <button type="submit" class="btn btn--primario">Agendar diagnóstico gratuito</button>
  <div class="cf-status" role="status" aria-live="polite" data-status></div>
</form>

<style>
  .cf { max-width: 36rem; }
  .campo { margin-bottom: var(--e3); }
  label { display: block; font-family: var(--fonte-mono); font-size: var(--t-rotulo); letter-spacing: 0.04em; margin-bottom: var(--e1); }
  input[type='text'], input[type='email'], input[type='tel'], select {
    width: 100%; min-height: 3rem; padding: 0.5rem var(--e2); border: var(--borda) solid var(--fg); border-radius: var(--raio);
    background: var(--superficie); color: var(--fg); font-family: var(--fonte-mono); font-size: 1rem;
  }
  input[aria-invalid='true'], select[aria-invalid='true'] { border: 2px solid var(--negativo); }
  .campo--check { display: grid; grid-template-columns: 1.5rem 1fr; gap: var(--e1); align-items: start; }
  .campo--check input { width: 1.5rem; height: 1.5rem; margin: 0.15rem 0 0; accent-color: var(--grafite); }
  .campo--check label { font-family: var(--fonte-texto); font-size: var(--t-pequeno); letter-spacing: 0; margin: 0; }
  .cf-hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .cf-fator { border: var(--borda) solid var(--linha); background: var(--superficie); padding: var(--e2); font-family: var(--fonte-mono); font-size: var(--t-pequeno); margin-bottom: var(--e3); }
  .cf-status { margin-top: var(--e3); }
  :global(.cf-ok) { border: var(--borda) solid var(--fg); padding: var(--e3); background: var(--superficie); }
  :global(.cf-erro) { color: var(--negativo); font-weight: 500; }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contato]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]')!;

    // Fator R vindo da calculadora: /contato?fator=22.5
    const fator = new URLSearchParams(location.search).get('fator');
    if (fator && /^\d{1,3}(\.\d)?$/.test(fator)) {
      const campo = form.querySelector<HTMLInputElement>('[data-fator-campo]')!;
      const aviso = form.querySelector<HTMLElement>('[data-fator]')!;
      campo.value = fator;
      aviso.hidden = false;
      aviso.textContent = `Fator R que você calculou: ${fator.replace('.', ',')}%. Vamos olhar isso juntos no diagnóstico.`;
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      status.textContent = '';
      const campos = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input:not([type=hidden]):not([tabindex="-1"]), select'));
      campos.forEach((c) => c.removeAttribute('aria-invalid'));
      const invalido = campos.find((c) => !c.checkValidity());
      if (invalido) {
        invalido.setAttribute('aria-invalid', 'true');
        const rot = form.querySelector<HTMLLabelElement>(`label[for="${invalido.id}"]`)?.textContent ?? 'campo';
        const p = document.createElement('p');
        p.className = 'cf-erro';
        p.textContent = invalido.id === 'lgpd' ? 'Marque o consentimento para continuar.' : `Preencha corretamente: ${rot}.`;
        status.append(p);
        invalido.focus();
        return;
      }
      // Honeypot preenchido: descarta em silêncio, como um envio normal.
      const hp = form.querySelector<HTMLInputElement>('#site-url');
      const p = document.createElement('p');
      p.className = 'cf-ok';
      p.textContent = hp?.value
        ? 'Recebido.'
        : 'Formulário fictício: este é um projeto de estudo e nenhum dado foi enviado. Em uma versão real, retornaríamos em 1 dia útil.';
      status.append(p);
      form.reset();
    });
  });
</script>
