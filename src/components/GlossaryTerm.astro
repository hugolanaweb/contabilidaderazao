---
interface Props {
  termo: string;
  /** definição curta, em texto puro */
  definicao: string;
}
const { termo, definicao } = Astro.props;
const id = `gl-${termo.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-${Math.random().toString(36).slice(2, 6)}`;
---
<span class="gl"><button type="button" class="gl-btn" popovertarget={id}>{termo}</button><span id={id} popover="auto" class="gl-pop" role="tooltip">{definicao}</span></span>

<style>
  .gl-btn {
    all: unset; cursor: pointer; border-bottom: 1px dotted currentColor; font: inherit;
  }
  .gl-btn:focus-visible { outline: 3px solid var(--foco, var(--grafite)); outline-offset: 2px; }
  .gl-pop {
    margin: 0; inset: auto; position: fixed; left: var(--e2); right: var(--e2); bottom: var(--e2); max-width: 26rem;
    background: var(--papel); color: var(--grafite); border: var(--borda) solid var(--grafite); padding: var(--e2);
    font-family: var(--fonte-mono); font-size: var(--t-pequeno);
  }
  @media (min-width: 40rem) { .gl-pop { inset: 0; margin: auto; left: auto; right: auto; } }
</style>
